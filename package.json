{
  "name": "maquina-de-reels",
  "version": "0.1.0",
  "description": "Crie reels narrados em português a partir de um roteiro: voz, legenda palavra por palavra e animações em código.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "maquina-de-reels": "cli/index.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "exemplo": "node cli/index.mjs criar exemplos/primeiro-reels --previa",
    "galeria": "node cli/galeria.mjs",
    "estudio": "remotion studio remotion/src/index.ts"
  },
  "keywords": [
    "reels",
    "remotion",
    "video",
    "tts",
    "portugues",
    "pt-br",
    "shorts",
    "tiktok"
  ],
  "dependencies": {
    "@remotion/bundler": "4.0.250",
    "@remotion/cli": "4.0.250",
    "@remotion/google-fonts": "4.0.250",
    "@remotion/install-whisper-cpp": "4.0.250",
    "@remotion/renderer": "4.0.250",
    "msedge-tts": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.5.4"
  }
}
